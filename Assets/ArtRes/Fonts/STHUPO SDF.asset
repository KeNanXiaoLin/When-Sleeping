    characterSequence: "\u6587\u6848\u4E0E\u6D41\u7A0B\r\n\u9605\u8BFB\u524D\u8BF7\u5148\u770B\u8FD9\uFF1A\r\n\u7EA2\u8272\u82F1\u6587\u4E3A\u53EF\u76F4\u63A5\u62D6\u7528\u590D\u5236\u7684\uFF0C\u5C55\u793A\u7ED9\u73A9\u5BB6\u770B\u7684\u90E8\u5206\r\n\u9ED1\u8272\u4E3A\u81EA\u5DF1\u770B\u7684\u65B9\u4FBF\uFF0C\u89E3\u91CA\u7684\u90E8\u5206\r\n\u6587\u5B57\u90E8\u5206\u6362\u884C\u8868\u793A\u9700\u8981\u73A9\u5BB6\u518D\u6B21\u70B9\u51FB\r\n\r\n\u6545\u4E8B\u7701\u6D41\r\n1\uFF0C\u4E3B\u89D2\u505A\u4E86\u602A\u5403\u4EBA\u7684\u68A6\r\n2\uFF0C\u5728\u9547\u4E0A\u53D1\u73B0\u4E86\u6709\u5173\u602A\u517D\u88AD\u51FB\u4EBA\u7684\u8BC1\u636E\uFF0C\u4ED6\u60F3\u8981\u6253\u8D25\u602A\u517D\r\n3\uFF0C\u4E3B\u89D2\u56E0\u4E3A\u6708\u5149\u548C\u4E00\u4E9B\u7269\u54C1\u5F3A\u884C\u56DE\u590Dsan\u503C\uFF08\u9053\u5177\u5982\u6536\u96C6\u4E86\u5149\u7684\u5FBD\u7AE0\uFF09\uFF0C\u53D8\u6210\u52C7\u58EB\uFF08\u4EBA\u7684\u7406\u667A+\u5F3A\u5316\u808C\u8089\uFF09\u4E0E\u602A\u640F\u6597\uFF0C\u89E3\u6551\u8DEF\u4EBA\r\n4\uFF0C\u5728\u9547\u4E0A\u8BE2\u95EE\u6709\u5173\u602A\u7684\u4F20\u95FB\uFF0C\u4E0Ebob\u4EA4\u8C08\uFF0Cbob\u4E5F\u4EA7\u751F\u60F3\u8981\u6253\u602A\u7684\u613F\u671B\u3002\r\n\uFF08\u6B64\u5904\u53EF\u4EE5\u5207bob\u89C6\u89D2\uFF09\r\n5\uFF0C\u4E3B\u89D2\u4E0E\u602A\u640F\u6597\uFF0C\u65E0\u6708\u5149\uFF0C\uFF08\u4F7F\u7528\u5FBD\u7AE0\uFF09\uFF08\u4E0A\u5E1D\u4E4B\u624B\uFF1A\u5FBD\u7AE0\u80FD\u91CF\u4E0D\u591F\u4E86\uFF09\u5FC5\u5931\u8D25\uFF0Csan\u503C\u6389\u81F360%\uFF0C\u753B\u9762\u5F00\u59CB\u51FA\u73B0\u566A\u70B9\u96EA\u82B1\uFF08\u4F7F\u7528\u94C3\u94DB\uFF09\uFF08\u4E0A\u5E1D\u4E4B\u624B\uFF1A\u5F3A\u5236\u4F20\u9001\u81F3\u5367\u5BA4\uFF09bob\u6C42\u6551\uFF0Cbob\u6B7B\u4EA1\u7ED3\u5C40\u3002\r\n\r\n\u6E38\u620F\u6D41\u7A0B\uFF1A\r\n\u5F00\u5C4Fcg
      \u753B\u9762\u6E10\u6E10\u9ED1\u5C4F\u6DE1\u51FA\r\n\u73A9\u5BB6\u6765\u5230\u5367\u5BA4\u573A\u666F\r\n\u53F3\u4E0A\u89D2san\u503C\uFF0C\u521D\u59CB100\r\nday1\u767D\u5929\r\n1.mike\uFF1A\u53C8\u505A\u68A6\u4E86\uFF0C\u600E\u4E48\u6700\u8FD1\u8001\u662F\u68A6\u5230\u5947\u602A\u7684\u573A\u666F\r\n2.\u522B\u7BA1\u4E86\uFF0C\u51FA\u53BB\u8D70\u8D70\u5427\uFF0C\u4ECA\u5929\u8FD8\u7EA6\u4E86bob\u6765\u5BB6\u91CC\u73A9
      \r\n\u73A9\u5BB6\u6765\u5230\u5BA2\u5385\u573A\u666F\r\n\u53EF\u4E0E\u76F8\u6846\u4EA4\u4E92\uFF1A3.\u8FD9\u662F\u4E00\u5F20\u5168\u5BB6\u798F\u3002\u4E0D\u8FC7\u7238\u7238\u6700\u8FD1\u51FA\u5DEE\u4E86\uFF0C\u4E0D\u77E5\u9053\u4EC0\u4E48\u65F6\u5019\u56DE\u6765\u3002\r\n\u53EF\u4E0E\u684C\u5B50\u4EA4\u4E92\uFF1A4.\u5403\u996D\u7684\u5730\u65B9\u3002\u6709\u65F6\u9664\u4E86\u996D\u8FD8\u60F3\u5403\u70B9\u522B\u7684\u3002\r\n\uFF08\u76F8\u6846\u684C\u5B50\u73A9\u5BB6\u662F\u5426\u4EA4\u4E92\u90FD\u4E0D\u5F71\u54CD\u5267\u60C5\u53D1\u5C55\uFF0C\u4F5C\u4E3A\u8865\u5145\uFF09\r\n\u53EF\u4E0E\u7535\u89C6\u4EA4\u4E92
      \uFF1A\u51FA\u73B0\u65B0\u95FB\uFF0C\u65B9\u5F0F\u4E3A\u80CC\u666F\u4ECD\u662F\u5367\u5BA4\uFF0C\u753B\u9762\u4E2D\u592E\u6709cg\uFF0C\u5E95\u4E0B\u63D0\u793A\u6846\uFF1A\r\n5.\u8FD1\u65E5\uFF0C\u9547\u4E0A\u9694\u58C1\u8001\u738B\u5931\u8E2A\u591A\u65E5\u540E\u786E\u8BA4\u9047\u5BB3\u3002\r\n6.\u636E\u900F\u9732\uFF0C\u6709\u4EBA\u4E0A\u5C71\u65F6\u6253\u730E\u65F6\u5728\u7684\u5C71\u4E2D\u53D1\u73B0\u4ED6\u7684\u6B8B\u7F3A\u7684\u9057\u4F53......\r\n\u89E6\u53D1san-20\r\n\r\n\u89E6\u53D1\u54CD\u8D77\u95E8\u94C3\u58F0\uFF0C\u662Fbob\u6765\u4E86\uFF0C\r\n\u5E95\u4E0B\u51FA\u73B0\u63D0\u793A\u6846\uFF1A7.bob\u6765\u4E86\uFF0C\u6211\u53BB\u5F00\u95E8\u5427\r\n\u73A9\u5BB6\u6765\u5230\u95E8\u53E3\uFF0C\u5207\u6362\u5230\u9662\u5B50\u573A\u666F\uFF0C\u4E8C\u4EBA\u5728\u9662\u5B50\u5BF9\u8BDD\r\n8.bob\uFF1A\u563Fbro\uFF0C\u770B\u6211\u5728\u5BB6\u91CC\u7FFB\u51FA\u4E00\u4E2A\u6C34\u6676\u5FBD\u7AE0\uFF0C\u9001\u7ED9\u4F60\r\n\u83B7\u5F97\u5FBD\u7AE0\uFF0C\u753B\u9762\u4E2D\u592E\u51FA\u73B0\u63D0\u793A\u6846\r\n9.\u6C34\u6676\u5FBD\u7AE0\uFF1A\u5FBD\u7AE0\u4E2D\u9576\u5D4C\u7740\u6C34\u6676\uFF0C\u5728\u9633\u5149\u4E0B\u5F88\u8000\u773C\uFF0C\u4F3C\u4E4E\u5F88\u73CD\u8D35\r\n10.mike\uFF1A\u8C22\u8C22\u4F60\uFF0C\u5F88\u597D\u770B\uFF0C\u6211\u5F88\u559C\u6B22\u3002
      \u89E6\u53D1san+5\r\n11.\u5BF9\u4E86\uFF0C\u4F60\u542C\u8BF4\u4E86\u9694\u58C1\u8001\u738B\u7684\u4E8B\u5417\uFF1F\u592A\u53EF\u6015\u4E86\uFF0C\u4ED6\u4F4F\u7684\u5C31\u79BB\u6211\u4EEC\u5BB6\u4E0D\u8FDC\u3002\r\n12.bob\uFF1A\u6211\u542C\u5BB6\u91CC\u4EBA\u8BF4\u4E86...\u4ED6\u4EEC\u8FD8\u8BA9\u6211\u4E0D\u8981\u591A\u95EE\u3002\r\n13.mike\uFF1A......\r\n14.\u4E00\u8D77\u8D70\u8D70\u5427\u3002\r\n\u53EF\u5728\u9662\u5B50\u91CC\u4EA4\u4E92\uFF1A\u4E00\u53EA\u732B\uFF1A15.\u732B\u62AC\u5934\u770B\u4E86\u4F60\u4E00\u773C\uFF0C\u5E76\u4F38\u4E86\u4E2A\u61D2\u8170 
      san+5\r\n\u4E00\u53EA\u72D7\uFF1A16.\u7EE7\u7EED\u7EE7\u7EED\uFF0C\u72D7\u5B50\u66F4\u559C\u6B22\u4F60\u4E86
      san+5\r\n\u89E6\u53D1\u83B7\u5F97\u4E86\u5E26\u8840\u7684\u7259\u9F7F\uFF0C
      san-5\r\n17.\u5E26\u8840\u7684\u7259\u9F7F\uFF1A\u8FD9\u8DDF\u4F60\u4E4B\u524D\u6362\u7684\u7259\u9F7F\u957F\u5F97\u5F88\u50CF\r\n\r\n\u4E8C\u4EBA\u8D70\u51FA\u9662\u5B50\uFF0C\u6765\u5230\u8857\u9053\u573A\u666F\uFF0C\u73A9\u5BB6\u5411\u53F3\u8FB9\u8D70\uFF0Cbob\u81EA\u52A8\u8DDF\u968Fmike\u884C\u8D70\r\n\u8857\u9053\u53EF\u4EA4\u4E92\uFF1A18.\u70B8\u9E21\u5E97\uFF1A\u597D\u5FC3\u7684\u8001\u677F\u7ED9\u4E86\u4E24\u4F4D\u5C0F\u670B\u53CB\u4E00\u4EBA\u4E00\u4E2A\u70B8\u9E21\u817F 
      san+5\r\n19.\u7CD6\u679C\u5E97\uFF1A\u5C0F\u65F6\u5019\u6700\u7231\u5403\u7684\u7CD6\u679C\u3002\u4E0D\u5BF9\u73B0\u5728\u5C31\u662F\u5C0F\u65F6\u5019\u554A\u5582\u3002\r\n20.\u82B1\u5E97\uFF1A\u4E70\u675F\u82B1\u5427\uFF0C\u6216\u8BB8\u63A5\u4E0B\u6765\u4F1A\u6709\u7528\r\n\u8D70\u5230\u9694\u58C1\u8001\u738B\u5BB6\u95E8\u53E3\r\n21.bob\uFF1A\u597D\u50CF\u662F\u9694\u58C1\u8001\u738B\u5BB6\u5728\u4E3E\u884C\u846C\u793C\r\n\u73A9\u5BB6\u8D70\u5230\u8001\u738B\u5BB6\u95E8\u53E3\uFF0C\u8FDB\u53BB\u5230\u846C\u793C\u573A\u666F\r\n\u4E24\u8DEF\u4EBAnpc\u5BF9\u8BDD\r\n22.\u7532\uFF1A\u4E0A\u5468\u6211\u8FD8\u8DDF\u8001\u738B\u804A\u5929\u5462\u3002\u54CE\u3002\u4ED6\u8BF4\u4ED6\u7761\u5F97\u4E0D\u592A\u597D\u3002\r\n23.\u4E59\uFF1A\u6211\u6700\u8FD1\u4E5F\u7761\u5F97\u4E0D\u597D\uFF0C\u9192\u6765\u603B\u662F\u5F88\u75B2\u60EB\u3002\r\n24.\u5947\u602A\u7684\u662F\uFF0C\u9192\u6765\u978B\u5B50\u4E0A\u6709\u6E7F\u6CE5\u571F\u7684\u75D5\u8FF9\u3002\u4F46\u6700\u8FD1\u53EA\u6709\u665A\u4E0A\u4E0B\u96E8\u554A\u3002\r\n\u7532\uFF1A......\r\nmike\u5728\u5730\u4E0A\u8FB9\u4E0A\u6361\u8D77\u5E76\u83B7\u5F97\uFF0C25.\u5F02\u5E38\u7684\u6BDB\u53D1\uFF1A\u8FD9\u8DDF\u4F60\u5728\u68A6\u4E2D\u7684\u602A\u517D\u7684\u6BDB\u53D1\u957F\u5F97\u5F88\u50CF 
      san-10\r\n\u8D70\u51FA\u846C\u793C\u573A\u666F\uFF0C\u6765\u5230\u8857\u9053\r\n26.\u5E95\u4E0B\u4E0A\u5E1D\u4E4B\u58F0\uFF1A\u5FEB\u508D\u665A\u4E86\uFF0C\u5FC3\u5E95\u6709\u4E00\u80A1\u529B\u91CF\u5728\u8BF4\u4F60\u4EEC\u8BE5\u56DE\u5BB6\u4E86\r\n27.mike:
      \u6211\u603B\u89C9\u5F97\u6709\u4E9B\u4E0D\u5BF9\uFF0Cbob\u4F60\u660E\u5929\u518D\u6765\u6211\u5BB6\u5427\r\n\u73A9\u5BB6\u5411\u5DE6\u8D70\u56DE\u5230\u9662\u5B50\uFF0C\u89E6\u53D1\u65F6\u949F\u9ED1\u5C4F\u8FC7\u573A\u52A8\u753B\r\n\r\nday1
      \u665A\u4E0A \u5367\u5BA4\u573A\u666F\r\nmike\u5728\u5E8A\u8FB9\r\n28.mike\uFF1A\u60F3\u60F3\u4ECA\u5929\u6240\u770B\u5230\u7684\u3002\u5947\u602A\u7684\u68A6\uFF0C\u9047\u5BB3\u7684\u9694\u58C1\u8001\u738B\uFF0C\u5E26\u8840\u7684\u7259\u9F7F\uFF0C\u5F02\u5E38\u7684\u6BDB\u53D1......\r\n29.\u4E2D\u592E\u51FA\u73B0\u9009\u9879\u5361\uFF0C\u56DB\u4E2A\u9009\u9879\uFF1A\u4F60\u8BA4\u4E3A\u8FD9\u662F\u56E0\u4E3A\uFF1F\r\n\u5916\u661F\u4EBA\u6253\u8FC7\u6765\u4E86\r\n\u602A\u7269\u5403\u4EBA\u4E0D\u6B62\u662F\u4E2A\u68A6\r\n\u6CA1\u7761\u9192\u6211\u8FD8\u5728\u505A\u68A6\r\n\u4E00\u5207\u7EAF\u5C5E\u610F\u5916\r\n\u9009\u5B8C\u540E\uFF0Cmom\u4ECE\u5DE6\u4E0B\u89D2\u51FA\u73B0\r\n30.mom\uFF1A\u5B9D\u8D1D\uFF0C\u559D\u4E86\u725B\u5976\u5FEB\u7761\u89C9\u5427\u3002 
      \r\n31.mike: \u6211\u6709\u70B9\u4E0D\u60F3\u559D\u3002 \r\n32.mom\uFF1A\u4E0D\u559D\u7684\u8BDD\u665A\u4E0A\u4F1A\u6709\u602A\u517D\u6765\u6293\u4F60\u5662\u3002\r\n33.mike\uFF1A\u6211\u624D\u4E0D\u6015\u5462\uFF0C\u6709\u602A\u517D\u6211\u4F1A\u6253\u8D25\u5B83\u7684\u3002\r\n\r\n\u4E0A\u5E1D\u4E4B\u58F0\uFF0C\u9ED1\u5C4F\u4E0B\u9762\u63D0\u793A\u6846\r\n34.\u4F60\u7761\u7740\u4E86...\r\n\u8FDB\u5165\u6218\u6597\u573A\u666F\r\n\u53D8\u56DEmike\u5934\u50CF\u7684\u5BF9\u8BDD\u6846\uFF1A\r\n35.\u8FD9\u91CC\u611F\u89C9\u597D\u50CF\u5E73\u5E38\u7684\u8857\u9053
      \r\n36.\u54C7\u6211\u7A7F\u7740\u52C7\u58EB\u7684\u94E0\u7532\uFF0C\u8FD8\u6709\u4E00\u628A\u5251\r\n37.\u53C8\u662F\u602A\u517D\uFF01
      \u7B49\u7B49\uFF0C\u90A3\u4E2A\u4EBA\u597D\u50CF\u662F\u6211\u4EEC\u9547\u4E0A\u7684\uFF0C\u5F97\u5FEB\u70B9\u53BB\u6551\u4ED6\uFF01
      \r\n\u6B64\u65F6\u5E95\u4E0B\u5F39\u51FA\u5BF9\u8BDD\u6846\uFF0C38.\u6C34\u6676\u95EA\u7740\u5947\u5F02\u7684\u5149\u8292\r\n\r\n\u7ECF\u8FC7\u4E86\u73A9\u5BB6\u4E00\u756A\u6218\u6597\r\n39.\u80DC\u5229\uFF1A\u4F60\u51FB\u8D25\u4E86\u602A\u517D\u6210\u529F\u4FDD\u62A4\u4E86\u6751\u6C11\r\n40.\u5931\u8D25\uFF1A\u8FD9\u662F\u4F60\u60F3\u8981\u7684\u7ED3\u5C40\u5417         
      \r\n\r\nday2 \u767D\u5929  \r\n41.mike\uFF1A\u8FD9\u592A\u5947\u602A\u4E86\uFF0C\u6211\u5C45\u7136\u53C8\u505A\u4E86\u8FD9\u79CD\u68A6
      san-10\r\n42.\u7B49\u4E0Bbob\u6765\uFF0C\u5FC5\u987B\u5F97\u548C\u4ED6\u8BF4\u4E00\u4E0B 
